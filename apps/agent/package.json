{
  "name": "@intake/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "//build": "Bundelen, niet los compileren: de workspace-packages worden als TypeScript-bron geïmporteerd en zijn voor Node niet direct uitvoerbaar.",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pipeline": "vitest run --config vitest.integration.config.ts --reporter verbose",
    "test:bakeoff": "vitest run --config vitest.bakeoff.config.ts --reporter verbose",
    "diag:bey": "tsx --env-file=../../.env bakeoff/bey-diagnose.ts",
    "diag:ttft": "tsx --env-file=../../.env bakeoff/ttft-diagnose.ts",
    "diag:netwerk": "tsx --env-file=../../.env bakeoff/netwerk-diagnose.ts",
    "dev:live": "tsx --env-file=../../.env live/server.ts --zonder-token",
    "diag:speechfinal": "tsx --env-file=../../.env bakeoff/speechfinal-diagnose.ts",
    "diag:gespreksvorm": "tsx --env-file=../../.env bakeoff/gespreksvorm-diagnose.ts",
    "diag:stilte": "tsx --env-file=../../.env bakeoff/stilte-diagnose.ts",
    "anam:persona": "tsx --env-file=../../.env bakeoff/anam-persona.ts",
    "diag:tikken": "tsx --env-file=../../.env bakeoff/tikken-diagnose.ts",
    "diag:afsluiten": "tsx --env-file=../../.env bakeoff/afsluiten-diagnose.ts",
    "zichtbaarheid": "node live/zichtbaarheid.mjs",
    "dev:live:https": "tsx --env-file=../../.env live/server.ts --zonder-token --tls",
    "//build:worker": "De realtime worker voor productie. live/server.ts is het startpunt dat echt luistert; src/main.ts doet dat nog niet. De banner geeft de bundel een werkende require(): een paar afhankelijkheden laden optionele modules met een dynamische require, en die bestaat niet in ESM.",
    "build:worker": "esbuild live/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/worker.js --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@intake/db-core": "workspace:*",
    "@intake/domain": "workspace:*",
    "@intake/engine": "workspace:*",
    "@intake/prompts": "workspace:^",
    "@intake/provider-avatar": "workspace:*",
    "@intake/provider-llm": "workspace:*",
    "@intake/provider-stt": "workspace:*",
    "@intake/provider-transport": "workspace:*",
    "@intake/provider-tts": "workspace:*",
    "@livekit/agents": "1.7.0",
    "@livekit/agents-plugin-bey": "1.7.0",
    "@livekit/rtc-node": "^0.13.34",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@anam-ai/js-sdk": "^4.25.0",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.24.2",
    "livekit-client": "^2.22.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
