# -----------------------------------------------------------------------------
# apps/agent — de langlevende realtime worker
# -----------------------------------------------------------------------------
# Let op wat hier NIET staat, en dat is opzet: geen sleutel waarmee dit proces bij
# meer dan één intake kan. De worker ontvangt bij sessiestart een kortlevend,
# ondoorzichtig token van de web-app dat aan precies één intake is gebonden, en kan
# daarmee uitsluitend de app.agent_* RPC's aanroepen. Hij kan zo'n token niet zelf
# maken: uitgifte gebeurt in apps/web met de secret key. De test
# packages/db/src/__tests__/agent-has-no-service-role.test.ts bewaakt dat.
#
# Hosting: een container in de EU (Fly.io / Railway / Hetzner / ECS), zo dicht
# mogelijk bij de Supabase-regio en de avatarvendor. Vercel en Netlify kunnen dit
# proces niet draaien: WebRTC met barge-in vraagt om een langlevend proces met een
# open audio/videoverbinding, en serverless routes hebben geen persistente sockets.

# Supabase — alleen de URL en de publishable key (sb_publishable_...). Die sleutel
# mag publiek zijn en geeft op zichzelf geen enkel recht; het sessietoken doet het
# werk. Zet hier nooit een sb_secret_... key neer: de envvalidatie in src/env.ts
# weigert dat expliciet.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# LiveKit — transport
LIVEKIT_URL=wss://
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT — Deepgram nova-3. Niet Flux: dat model doet geen Nederlands.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# TTS — ElevenLabs primair sinds 26 augustus 2026, Cartesia als tweede.
#
# De wissel staat in RISICOS.md 17b. Kort: Cartesia liet in 7 van de 9 metingen de
# openingsgroet vallen en in 1 van de 9 het woord "geen" uit "ik ben geen advocaat" -- de
# disclaimer waarvoor de client tekent. ElevenLabs: 0 van de 9 op alle drie de foutvormen.
# Eerste audio scheelt 8 ms.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Spreektempo, 0,7-1,2. Gemeten op de openingszin, door de hele keten:
#   1,0  ongeveer 10,4 s   (standaard van de leverancier)
#   1,1  ongeveer  9,4 s   <- onze standaard
#   1,2  ongeveer  8,4 s   (maximum dat hun API toestaat)
# Cartesia deed dezelfde zin in 7,5 s. Het verschil is dus te verkleinen maar niet weg te
# nemen. Hier aan draaien vraagt geen commit; hoger dan 1,2 weigert hun API.
ELEVENLABS_SPEED=1.1

# Cartesia blijft werkend als tweede optie, zodat de vergelijking te herhalen is.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# sonic-3; sonic, sonic-2 en sonic-turbo zijn uitgefaseerd.
CARTESIA_MODEL=sonic-3

# Overrulet provider_config.tts van het kantoor. Voor een losse proef; normaal leeg.
# cartesia | elevenlabs | fake
TTS_PROVIDER=

# LLM — EU-endpoint, niet de globale
ANTHROPIC_API_KEY=
LLM_HOT_MODEL=claude-haiku-4-5-20251001
LLM_COLD_MODEL=claude-sonnet-5

# Avatar — leeg laten schakelt de null-provider in (statische placeholder)
AVATAR_PROVIDER=null
BEY_API_KEY=
BEY_AVATAR_ID=
ANAM_API_KEY=
ANAM_AVATAR_ID=
# De persona bepaalt gezicht én stemgedrag. Hij moet llmId "Disable LLM" hebben, anders
# antwoordt hun model door onze antwoorden heen. Zie docs/anam-personas-en-avatars.md.
ANAM_PERSONA_ID=

# Latency-HUD staat aan buiten productie. Op productie zet dit ook de weigering aan van
# --zonder-token: die vlag zou de sessieverificatie uitzetten en de socket voor iedereen
# openzetten.
NODE_ENV=development

# De poort krijgt de worker van de hostingpartij (Railway zet PORT). Lokaal valt hij terug
# op LIVE_PORT en anders op 5174; zelf iets anders binden betekent dat er nooit verkeer
# binnenkomt en alleen de healthcheck faalt.
# PORT=

# Sessieduur. Beide zijn kostenposten: elke seconde avatar kost geld.
# INACTIVITEIT_MS=90000
# RESPIJT_MS=30000

# --- Afstellen van het onderbrekingsgedrag ---------------------------------
#
# Alleen op gehoor af te stellen, dus verstelbaar zonder deploy. Leeg laten = de
# standaard uit de code. Een verkeerde waarde weigert bij het opstarten met de
# reden erbij; de geldende stand staat in de opstartbanner met een * bij wat afwijkt.
#
# Waarom deze getallen vandaag niet doen wat hun naam belooft: RISICOS.md risico 21.
# `speechMs` meet netwerkretour en geen spraakduur, en geen enkele waarde repareert
# dat. Verstelbaar maken is onderzoek, geen reparatie.

# Minimale speechMs voor een harde onderbreking. Standaard 180.
INTERRUPT_MIN_SPEECH_MS=
# Minimaal aantal woorden in de eerste partial. Standaard 2.
INTERRUPT_MIN_WORDS=
# Boven deze waarde telt "ja" niet meer als bevestiging maar als onderbreking.
# Standaard 400, en gemeten komt een bevestiging pas rond 1570 ms binnen -- dus de
# standaard laat de rem nooit aanslaan. Dit is de eerste proef die de moeite waard is.
BACKCHANNEL_MAX_MS=

# Stilte in ms voordat de beurt van de client sluit -- bepaalt hoe snel de assistent
# begint te praten. Standaard 300. Te laag knipt midden in een denkpauze.
DEEPGRAM_ENDPOINTING_MS=
# Vangnet dat de beurt sluit op gaten tussen woordtijdstempels. Standaard 1000; lager
# accepteert Deepgram niet. Voedt ook de detector voor een te vroege knip.
DEEPGRAM_UTTERANCE_END_MS=

# De microfoonpoort in de browser. Deze twee gaan mee in het ready-bericht, zodat ze
# in Railway te verstellen zijn zonder een nieuwe webdeploy.
# RMS waarboven de poort opengaat. Standaard 0.005. 0 stuurt alles door, ook de echo
# van de assistent zelf.
MIC_GATE_RMS=
# Hoe lang het stil moet zijn voordat de poort dichtgaat. Standaard 120.
MIC_GATE_CLOSE_MS=
