# =============================================================================
# Legal Intake AI — omgevingsvariabelen
# =============================================================================
# Kopieer naar .env.local (web) en apps/agent/.env (worker). Nooit committen.
#
# Regiokeuze is geen detail: Supabase, de agent-worker, STT, TTS, het LLM-endpoint
# en de avatarvendor horen allemaal in dezelfde EU-regio. Eén trans-atlantische hop
# kost 80–120 ms die je in élke beurt betaalt, en een Nederlands advocatenkantoor kan
# een verwerker buiten de EU niet contracteren.

# -----------------------------------------------------------------------------
# Supabase  (project MOET in eu-central-1 of eu-west-1 staan)
# -----------------------------------------------------------------------------
# Dit project gebruikt de nieuwe API-keys en dus asymmetrische JWT signing keys.
# Er is bewust GEEN gedeeld HS256-secret: dat bestaat hier niet, en het verdwijnt
# eind 2026 sowieso. Het agent-sessietoken is daarom geen zelfondertekend JWT maar
# een ondoorzichtig token met een lookup in de database — zie
# docs/ADR-0007-agent-sessietoken.md.
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_... — mag publiek zijn, geeft op zichzelf geen rechten.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# sb_secret_... — omzeilt RLS. Alleen server-side in apps/web, en NIET in apps/agent;
# zie packages/db/src/__tests__/agent-has-no-service-role.test.ts.
SUPABASE_SECRET_KEY=sb_secret_

# Pepper voor het hashen van IP-adressen in de rate limiter. Willekeurig, ≥32 tekens.
# Nooit het ruwe IP opslaan.
INTAKE_IP_HASH_PEPPER=

# -----------------------------------------------------------------------------
# Transport
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# Realtime pipeline
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=
# Niet 'flux': dat model bestaat niet voor Nederlands (het komt in de modellenlijst
# in geen enkele taal voor). nova-3 dekt nl, nl-BE en nl-NL.
# nova-3 en niet flux: Flux draait op /v2/listen, kent geen language-parameter en heeft
# alleen een Engelstalig model (flux-general-en). Zie de correctie onderaan ADR-0009.
DEEPGRAM_MODEL=nova-3

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# sonic-3; sonic, sonic-2 en sonic-turbo zijn uitgefaseerd.
CARTESIA_MODEL=sonic-3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

ANTHROPIC_API_KEY=
# Hot path: klein en snel. TTFT is de grootste enkele hefboom op de ervaren latency.
LLM_HOT_MODEL=claude-haiku-4-5-20251001
# Cold path: kwaliteit boven snelheid, strikte schema's.
LLM_COLD_MODEL=claude-sonnet-5

# Claude via Vertex AI in europe-west4 (Eemshaven, NL). Zie ADR-0012.
#
# Twee redenen om hier naartoe te gaan: het architectuurdocument eist een EU-endpoint voor
# de subverwerkerketen, en de netwerkpost zakt van ~123 ms naar ~15 ms per verzoek.
# Uit de service-account-JSON: project_id, client_email, private_key.
VERTEX_PROJECT_ID=
VERTEX_REGION=europe-west4
VERTEX_CLIENT_EMAIL=
# De PEM op een regel, met 
 voor de regeleindes.
VERTEX_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Avatar
# -----------------------------------------------------------------------------
# 'null'  = geen gezicht. De browser speelt onze TTS rechtstreeks af; kost geen
#           avatarminuten en is de default.
# 'anam'   = pratend gezicht in pnpm dev:live. Vraagt ANAM_API_KEY en ANAM_AVATAR_ID.
# Bey staat hier bewust nog niet bij: zijn sessies starten niet, zie FASE-1-KEYS.md.
AVATAR_PROVIDER=null
BEY_API_KEY=
BEY_AVATAR_ID=
ANAM_API_KEY=
# Twee manieren om het gezicht te kiezen; vul er één in.
#
# ANAM_AVATAR_ID  — UUID uit GET /v1/avatars. Alléén het gezicht, en dat is wat je hier
#                   wilt: wij leveren de stem via passthrough en de taal komt uit ons
#                   eigen gesprek.
# ANAM_PERSONA_ID — UUID uit GET /v1/personas. Een kant-en-klaar profiel met stem, taal en
#                   systeemprompt erbij. De stock-persona's zijn demo's
#                   ("Anika - Spanish Barista") en zelden wat je voor een intake wilt.
#
# Ze zijn NIET uitwisselbaar: een avatar-UUID als persona geeft HTTP 400
# "Persona not found or unavailable".
ANAM_AVATAR_ID=
ANAM_PERSONA_ID=
# Verplicht zodra ANAM_AVATAR_ID is ingevuld: hun CustomPersonaConfig eist personaId,
# avatarId en voiceId samen. UUID uit GET /v1/voices. Bij passthrough wordt deze stem
# niet gebruikt; hij moet er alleen zijn.
ANAM_VOICE_ID=

# -----------------------------------------------------------------------------
# Tests tegen een echte database
# -----------------------------------------------------------------------------
# De tenant-isolatiesuite draait tegen een echte Supabase-database, omdat
# RLS-policies Postgres-gedrag zijn en een mock daarvan alleen de mock test.
# Gebruik een apart testproject, nooit productie: de suite maakt organisaties,
# gebruikers en intakes aan en ruimt die weer op.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=sb_publishable_
SUPABASE_TEST_SECRET_KEY=sb_secret_
