# =============================================================================
# Legal Intake AI — omgevingsvariabelen
# =============================================================================
# Kopieer naar .env.local (web) en apps/agent/.env (worker). Nooit committen.
#
# Regiokeuze is geen detail: Supabase, de agent-worker, STT, TTS, het LLM-endpoint
# en de avatarvendor horen allemaal in dezelfde EU-regio. Eén trans-atlantische hop
# kost 80–120 ms die je in élke beurt betaalt, en een Nederlands advocatenkantoor kan
# een verwerker buiten de EU niet contracteren.

# -----------------------------------------------------------------------------
# Supabase  (project MOET in eu-central-1 of eu-west-1 staan)
# -----------------------------------------------------------------------------
# Dit project gebruikt de nieuwe API-keys en dus asymmetrische JWT signing keys.
# Er is bewust GEEN gedeeld HS256-secret: dat bestaat hier niet, en het verdwijnt
# eind 2026 sowieso. Het agent-sessietoken is daarom geen zelfondertekend JWT maar
# een ondoorzichtig token met een lookup in de database — zie
# docs/ADR-0007-agent-sessietoken.md.
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_... — mag publiek zijn, geeft op zichzelf geen rechten.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# sb_secret_... — omzeilt RLS. Alleen server-side in apps/web, en NIET in apps/agent;
# zie packages/db/src/__tests__/agent-has-no-service-role.test.ts.
SUPABASE_SECRET_KEY=sb_secret_

# Pepper voor het hashen van IP-adressen in de rate limiter. Willekeurig, ≥32 tekens.
# Nooit het ruwe IP opslaan.
INTAKE_IP_HASH_PEPPER=

# -----------------------------------------------------------------------------
# Transport
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# Realtime pipeline
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

ANTHROPIC_API_KEY=
# Hot path: klein en snel. TTFT is de grootste enkele hefboom op de ervaren latency.
LLM_HOT_MODEL=claude-haiku-4-5-20251001
# Cold path: kwaliteit boven snelheid, strikte schema's.
LLM_COLD_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# Avatar
# -----------------------------------------------------------------------------
# 'null' = statische placeholder; werkt zonder account en is de default tot de
# bakeoff in Fase 1 is gedraaid.
AVATAR_PROVIDER=null
BEY_API_KEY=
BEY_AVATAR_ID=
ANAM_API_KEY=
ANAM_AVATAR_ID=

# -----------------------------------------------------------------------------
# Tests tegen een echte database
# -----------------------------------------------------------------------------
# De tenant-isolatiesuite draait tegen een echte Supabase-database, omdat
# RLS-policies Postgres-gedrag zijn en een mock daarvan alleen de mock test.
# Gebruik een apart testproject, nooit productie: de suite maakt organisaties,
# gebruikers en intakes aan en ruimt die weer op.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=sb_publishable_
SUPABASE_TEST_SECRET_KEY=sb_secret_
